# 从 .env.example 复制为 .env，真实密钥只填入本机 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_DEFAULT_PROVIDER=deepseek
LLM_TIMEOUT_SECONDS=60

# 默认仅本机访问。Linux 容器或局域网监听时，必须同时设置足够长的访问令牌。
STORESPARK_HOST=127.0.0.1
STORESPARK_PORT=8000
STORESPARK_ACCESS_TOKEN=
# 留空时，数据保存在项目根目录 data 下。
STORESPARK_DATA_DIR=
